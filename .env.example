SA_PASSWORD=YourStrong!Passw0rd
JWT_SECRET=CAMBIAR-ESTE-SECRETO-EN-PRODUCCION-min-32-caracteres-1234567890

# Correo saliente (SMTP directo contra el buzón real de la empresa, ej. cPanel de jimaco.com.co).
# OJO: cPanel ("Conectar dispositivos") recomienda "mail.jimaco.com.co", pero ese subdominio NO
# tiene registro DNS real (nunca se creó) — usar en cambio el hostname real del servidor detrás
# (se obtiene con un PTR/reverse-DNS de la IP del dominio), que es con el que sí calza el
# certificado SSL. Confirmado 2026-09-08: s3452.mex1.stableserver.net. Si esto deja de funcionar,
# no asumir que sigue siendo el mismo — repetir el PTR (puede cambiar si migran de servidor).
# SMTP_USE_SSL=true asume conexión SSL directa (puerto típico 465); si el proveedor usa STARTTLS
# (puerto típico 587), poner false.
SMTP_HOST=s3452.mex1.stableserver.net
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USUARIO=sistemas@jimaco.com.co
SMTP_PASSWORD=CAMBIAR-POR-LA-CONTRASENA-REAL-DEL-BUZON
SMTP_REMITENTE_NOMBRE=Jimaco Aprobaciones
